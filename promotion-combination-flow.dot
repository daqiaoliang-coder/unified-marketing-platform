digraph PromotionCombinationFlow {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad=0.35,
    nodesep=0.5,
    ranksep=0.42,
    splines=polyline,
    fontname="Helvetica",
    fontsize=23,
    fontcolor="#0F172A",
    labelloc=t,
    label="VMP · 优惠组合计算流程\n ",
    source="用户提供的 VMP 读接口流程说明",
    tooltip="基于项目经历说明绘制，不代表经源码验证的实现；仅展示优惠组合主链路。"
  ];
  node [shape=box, width=5.4, height=0.65, style="rounded,filled", fillcolor="#FFFFFF", color="#CBD5E1", penwidth=1.2, fontname="Helvetica", fontsize=14, fontcolor="#1E293B", margin="0.22,0.14"];
  edge [color="#64748B", penwidth=1.3, arrowsize=0.7, fontname="Helvetica", fontsize=12, fontcolor="#475569"];

  request [label="优惠计算请求", shape=oval, width=3.4, fillcolor="#0F172A", color="#0F172A", fontcolor="#FFFFFF"];

  subgraph cluster_prepare {
    label="01  数据准备";
    labeljust=l;
    fontsize=15;
    fontcolor="#475569";
    color="#E2E8F0";
    style="rounded,filled";
    fillcolor="#F1F5F9";
    margin=20;
    fetch_data [label="查询计划 / 过滤器 / Callback\n从 Callable 获取计算数据"];
    attach [label="将候选优惠活动挂载到订单"];
  }

  subgraph cluster_calculate {
    label="02  单订单优惠组合计算";
    labeljust=l;
    fontsize=15;
    fontcolor="#0F766E";
    color="#99D9D0";
    style="rounded,filled";
    fillcolor="#F0FDFA";
    margin=22;
    order [label="取下一个待计算订单\n使用当前计价基准", fillcolor="#CCFBF1", color="#5BB9AD"];
    stacking [label="计算允许的叠加组合\n自叠加 · 活动类型叠加 · 排他约束"];
    next_stacking [label="还有叠加组合？", shape=diamond, width=4.6, height=0.95, style=filled, fillcolor="#FFFFFF", margin=0.06];
    product [label="取一个叠加组合，计算笛卡尔积\n每个元素展开为一个具体优惠组合", fillcolor="#CCFBF1", color="#5BB9AD"];
    next_combination [label="还有未计算的\n具体优惠组合？", shape=diamond, width=4.6, height=0.95, style=filled, fillcolor="#FFFFFF", margin=0.05];
    plugin [label="取一个具体优惠组合\n通过插件过滤器，由插件计算优惠"];
    engine [label="优惠工具执行引擎\n条件元数据 + 配置元数据 → 结果元数据", fillcolor="#FFFFFF", color="#5BB9AD"];
    collect [label="汇总当前订单的优惠计算结果"];
  }

  update [label="更新子订单实付款\n供后续主订单基准价计算使用", fillcolor="#EEF2FF", color="#A5B4FC"];
  next_order [label="还有待计算订单？", shape=diamond, width=4.6, height=0.95, style=filled, fillcolor="#FFFFFF", margin=0.05];
  finish [label="返回优惠计算结果", shape=oval, fillcolor="#0F172A", color="#0F172A", fontcolor="#FFFFFF"];
  orchestration [label="编排能力\n排序 / 优惠均摊 / 各方分润\n具体执行时点未在原材料中限定", shape=note, style=filled, fillcolor="#FFF7ED", color="#FDBA74", fontsize=12];
  scope [label="依据：用户提供的 VMP 流程说明\n仅展示读接口主链路；未展开异常与无优惠分支", shape=plain, style="", fontsize=11, fontcolor="#64748B"];

  request -> fetch_data;
  fetch_data -> attach;
  attach -> order;
  order -> stacking;
  stacking -> next_stacking;
  next_stacking -> product [label="是"];
  product -> next_combination;
  next_combination -> plugin [label="是"];
  plugin -> engine;
  engine:e -> next_combination:e [label="下一个具体组合", color="#0D9488", fontcolor="#0F766E", constraint=false];
  next_combination:w -> next_stacking:w [label="否：下一叠加组合", color="#0D9488", fontcolor="#0F766E", constraint=false];
  next_stacking:e -> collect:e [label="否：当前订单组合已算完", minlen=5];
  engine -> collect [style=invis];
  collect -> update;
  update -> next_order;
  next_order:w -> order:w [label="是：继续下一个订单", color="#6366F1", fontcolor="#4F46E5", constraint=false];
  next_order -> finish [label="否"];
  orchestration -> collect [style=dashed, arrowhead=none, color="#D97706", constraint=false];
  { rank=same; update; orchestration; }
  finish -> scope [style=invis];
}
